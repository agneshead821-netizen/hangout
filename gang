<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Senior Class - Ultimate Would You Rather (Fall Edition)</title>
    <style>
        :root {
            --bg-color: #2b1810; /* Cozy Dark Clove/Bark */
            --card-bg: #3d2314; /* Warm Chestnut */
            --accent-primary: #d97706; /* Pumpkin Spice Orange */
            --accent-secondary: #991b1b; /* Cranberry Crimson */
            --accent-gold: #f59e0b; /* Maple Gold */
            --text-main: #fef3c7; /* Soft Cream / Vanilla */
            --text-muted: #b45309; /* Warm Amber Muted */
            --danger: #b91c1c; /* Deep Red */
            --success: #15803d; /* Forest Green */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        header h1 {
            font-size: 2.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            background: linear-gradient(to right, var(--accent-primary), var(--accent-gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0px 4px 10px rgba(0, 0, 0, 0.4);
        }

        header p {
            color: #d97706;
            margin-top: 5px;
            font-weight: 500;
        }

        .game-container {
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: 30px;
            max-width: 1400px;
            width: 100%;
            height: calc(100vh - 140px);
            min-height: 600px;
        }

        /* Left Side: Setup & Wheel */
        .left-panel {
            display: flex;
            flex-direction: column;
            gap: 20px;
            background: var(--card-bg);
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5);
            border: 2px solid #54311c;
        }

        .panel-title {
            font-size: 1.25rem;
            font-weight: 600;
            border-bottom: 2px solid #54311c;
            padding-bottom: 8px;
            margin-bottom: 10px;
            color: var(--accent-gold);
        }

        .players-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            overflow-y: auto;
            flex-grow: 1;
            padding-right: 5px;
        }

        .player-card {
            background: #2b1810;
            border: 2px solid #54311c;
            border-radius: 10px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            transition: all 0.2s;
        }

        .player-card.active-selection {
            border-color: var(--accent-gold);
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
        }

        .image-slot {
            width: 65px;
            height: 65px;
            background: #3d2314;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            overflow: hidden;
            border: 2px dashed #78350f;
            position: relative;
        }

        .image-slot img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .image-slot input[type="file"] {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .player-name {
            width: 100%;
            background: transparent;
            border: none;
            color: var(--text-main);
            text-align: center;
            margin-top: 8px;
            font-size: 0.85rem;
            border-bottom: 1px dashed #78350f;
            padding: 2px;
        }

        .player-name:focus {
            outline: none;
            border-bottom-color: var(--accent-gold);
        }

        .bail-badge {
            position: absolute;
            top: 5px;
            right: 5px;
            background: var(--success);
            color: white;
            font-size: 0.65rem;
            padding: 2px 6px;
            border-radius: 20px;
            font-weight: bold;
        }

        .bail-badge.used {
            background: var(--danger);
            text-decoration: line-through;
            opacity: 0.6;
        }

        /* Wheel Area */
        .wheel-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 15px 0;
            position: relative;
        }

        .spin-btn {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: white;
            border: none;
            padding: 14px 40px;
            font-size: 1.3rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(217, 119, 6, 0.4);
            transition: transform 0.1s, box-shadow 0.2s;
            width: 100%;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .spin-btn:hover {
            box-shadow: 0 6px 20px rgba(217, 119, 6, 0.6);
        }

        .spin-btn:active {
            transform: scale(0.98);
        }

        /* Right Side: The Stage / Projector Screen */
        .right-panel {
            background: linear-gradient(145deg, #3d2314, #2b1810);
            border-radius: 16px;
            padding: 35px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 2px solid #54311c;
            box-shadow: inset 0 0 40px rgba(0,0,0,0.6);
            position: relative;
        }

        .active-turn-banner {
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(43, 24, 16, 0.7);
            padding: 15px 25px;
            border-radius: 12px;
            border-left: 5px solid var(--accent-gold);
        }

        .banner-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #54311c;
            object-fit: cover;
            border: 2px solid var(--accent-gold);
        }

        .banner-text h2 {
            font-size: 1.5rem;
            color: var(--text-main);
        }
        
        .banner-text p {
            color: #d97706;
            font-size: 0.9rem;
        }

        /* Slide View Display */
        .prompt-display {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin: 30px 0;
            text-align: center;
        }

        .wyr-title {
            font-size: 1.8rem;
            color: var(--accent-gold);
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 25px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }

        .options-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            width: 100%;
            position: relative;
        }

        .option-box {
            background: rgba(43, 24, 16, 0.6);
            border: 2px solid #54311c;
            padding: 25px;
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 160px;
            transition: border-color 0.3s;
        }

        .option-letter {
            font-size: 1.1rem;
            font-weight: bold;
            color: var(--accent-primary);
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .option-text {
            font-size: 1.35rem;
            font-weight: 500;
            line-height: 1.5;
            color: #fef3c7;
        }

        .or-divider {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            background: var(--accent-secondary);
            color: white;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1.1rem;
            box-shadow: 0 0 15px rgba(153, 27, 27, 0.6);
            z-index: 2;
        }

        .penalty-notice {
            margin-top: 25px;
            background: rgba(185, 28, 28, 0.2);
            border: 1px solid rgba(185, 28, 28, 0.5);
            color: #fca5a5;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 500;
            display: none;
            width: 100%;
        }

        /* Bottom Controls & Timer */
        .bottom-bar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 20px;
            border-top: 2px solid #54311c;
            padding-top: 25px;
        }

        .timer-box {
            font-size: 3rem;
            font-weight: 800;
            font-family: monospace;
            color: var(--accent-gold);
